#!/usr/bin/env bash
set -euo pipefail

ctl=""

collie_config_dir() {
  if [[ -n "${HERDR_PLUGIN_CONFIG_DIR:-}" ]]; then
    printf '%s\n' "$HERDR_PLUGIN_CONFIG_DIR"
  else
    printf '%s\n' "${HOME}/.config/herdr/plugins/config/herdr.collie"
  fi
}

port_from_collie_config() {
  local env_file
  env_file="$(collie_config_dir)/.env"
  [[ -f "$env_file" ]] || return 0
  sed -n 's/^[[:space:]]*COLLIE_PORT[[:space:]]*=[[:space:]]*"\?\([0-9]\{1,5\}\)"\?[[:space:]]*$/\1/p' \
    "$env_file" | tail -n1
}

collie_port="${COLLIE_PORT:-}"
[[ -n "$collie_port" ]] || collie_port="$(port_from_collie_config)"
collie_port="${collie_port:-8787}"

[[ "$collie_port" =~ ^[0-9]{1,5}$ ]] || {
  printf 'COLLIE_PORT must be a port number, got: %s\n' "$collie_port" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || {
    printf 'Required command not found: %s\n' "$1" >&2
    exit 1
  }
}

# Collie ships collie-ctl.sh, which is the only safe way to publish and retract the tailnet front
# door: it refuses to overwrite a `tailscale serve` root mount it does not own, and it retracts only
# the mapping it recorded as its own. Reimplementing that here would silently unpublish unrelated
# services, so a missing ctl is a hard failure rather than a fallback to raw `tailscale serve`.
find_collie_ctl() {
  local candidate
  for candidate in "${HOME}"/.config/herdr/plugins/github/herdr.collie-*/scripts/collie-ctl.sh; do
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

resolve_collie_ctl() {
  ctl="$(find_collie_ctl || true)"
  [[ -n "$ctl" ]] || {
    printf 'collie-ctl.sh not found. Install Collie as the herdr.collie Herdr plugin first.\n' >&2
    exit 1
  }
}

service_active() {
  systemctl --user is-active --quiet collie
}

# Fails when the serve config cannot be read at all, which is a different state from "Collie is not
# published" and must not be reported as one. An empty-but-valid config is `{}` with exit 0.
serve_json() {
  tailscale serve status --json 2>/dev/null
}

# The tailnet URL of the handler that proxies to our loopback port, or nothing when Collie is not
# published. Keyed on the proxy target rather than on position, so an unrelated mapping listed first
# is never mistaken for Collie's. Reads the scheme from the TCP entry so http serve mode and
# non-default serve ports resolve correctly.
collie_url() {
  local json="$1"
  [[ -n "$json" ]] || return 0
  printf '%s' "$json" | jq -r --arg proxy "http://127.0.0.1:${collie_port}" '
    . as $root
    | (.Web // {})
    | to_entries[]
    | select([.value.Handlers // {} | to_entries[] | .value.Proxy] | index($proxy))
    | .key as $hostport
    | ($hostport | capture("^(?<host>.*):(?<port>[0-9]+)$")) as $parts
    | (if (($root.TCP // {})[$parts.port].HTTPS // false) then "https" else "http" end) as $scheme
    | if ($scheme == "https" and $parts.port == "443")
        or ($scheme == "http" and $parts.port == "80")
      then $scheme + "://" + $parts.host
      else $scheme + "://" + $hostport
      end
  ' 2>/dev/null | head -n1 || true
}

show_status() {
  local json url service=0 serve=0
  service_active && service=1 || true

  if ! json="$(serve_json)"; then
    if (( service )); then
      printf 'unknown\tService is active, but the tailnet endpoint state is unavailable\t\n'
    else
      printf 'unknown\tCollie state is unavailable\t\n'
    fi
    return 0
  fi

  url="$(collie_url "$json")"
  [[ -n "$url" ]] && serve=1 || true

  if (( service && serve )); then
    printf 'running\tService and tailnet endpoint are active\t%s\n' "$url"
  elif (( !service && !serve )); then
    printf 'disabled\tService and tailnet endpoint are off\t%s\n' "$url"
  elif (( service )); then
    printf 'partial\tService is active, but the tailnet endpoint is off\t%s\n' "$url"
  else
    printf 'partial\tTailnet endpoint is active, but the service is stopped\t%s\n' "$url"
  fi
}

do_enable() {
  resolve_collie_ctl
  "$ctl" start >/dev/null
}

do_disable() {
  local json url ownership_file
  resolve_collie_ctl

  # Older versions of this widget published Collie directly, before Collie tracked ownership of
  # its Tailscale root. Adopt only an existing handler that the status parser has already proved
  # proxies to Collie's loopback port. collie-ctl.sh performs its own ownership check as well.
  ownership_file="$(collie_config_dir)/tailscale-managed-handler"
  if [[ ! -f "$ownership_file" ]] && json="$(serve_json)"; then
    url="$(collie_url "$json")"
    if [[ -n "$url" ]]; then
      "$ctl" serve >/dev/null
    fi
  fi

  "$ctl" unserve >/dev/null
  "$ctl" stop >/dev/null
}

require_command systemctl
require_command tailscale
require_command jq

case "${1:-status}" in
  status)
    show_status
    ;;
  enable)
    do_enable
    show_status
    ;;
  disable)
    do_disable
    show_status
    ;;
  toggle)
    if [[ "$(show_status | cut -f1)" == "running" ]]; then
      do_disable
    else
      do_enable
    fi
    show_status
    ;;
  *)
    printf 'usage: %s {status|enable|disable|toggle}\n' "$0" >&2
    exit 2
    ;;
esac
